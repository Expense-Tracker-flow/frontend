{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow-frontend",
  "main": ".vercel/output/static/_worker.js/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".vercel/output/static",
    "binding": "ASSETS"
  }
}
